{
	"$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
	"productName": "Kefer",
	"version": "0.1.0",
	"identifier": "dev.kefer.astrology",
	"build": {
		"frontendDist": "../apps/web-react/dist",
		"devUrl": "http://localhost:1420",
		"beforeDevCommand": "npm run dev -w web-react",
		"beforeBuildCommand": "npm run build -w web-react"
	},
	"app": {
		"windows": [
			{
				"title": "Kefer",
				"decorations": false,
				"width": 1024,
				"height": 768,
				"minWidth": 480,
				"minHeight": 600,
				"resizable": true,
				"fullscreen": false
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"resources": [
			"binaries",
			"resources/pck11.pca",
			"resources/de440s.bsp",
			"resources/codes_300ast_20100725.bsp",
			"resources/chiron_1900_2100_type13.bsp",
			"resources/chiron_1900_2100_type13.bsp.json"
		],
		"windows": {
			"certificateThumbprint": null,
			"digestAlgorithm": "sha256",
			"timestampUrl": "http://timestamp.digicert.com"
		},
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
