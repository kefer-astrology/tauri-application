{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kefer-astrology/kefer-contracts/contracts/schemas/catalogs/aspects.schema.json",
  "title": "Canonical aspect catalog",
  "type": "object",
  "required": [
    "schema_version",
    "catalog_version",
    "aliases",
    "aspects"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "catalog_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "aliases": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "aspects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "angle",
          "harmonic",
          "default_orb",
          "aspect_type"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z_]+$"
          },
          "label": {
            "type": "string"
          },
          "angle": {
            "type": "number",
            "minimum": 0,
            "maximum": 180
          },
          "angle_expression": {
            "type": "string"
          },
          "harmonic": {
            "type": "integer",
            "minimum": 1
          },
          "default_orb": {
            "type": "number",
            "minimum": 0
          },
          "aspect_type": {
            "enum": [
              "major",
              "minor"
            ]
          }
        }
      }
    }
  }
}
