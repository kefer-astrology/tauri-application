{
	"name": "kefer-astrology",
	"private": true,
	"version": "0.1.1",
	"description": "Kefer astrology monorepo: Tauri 2, React UI, Python sidecar.",
	"type": "module",
	"workspaces": [
		"apps/*"
	],
	"scripts": {
		"dev": "npm run dev -w web-react",
		"dev:svelte": "npm run dev -w web-svelte",
		"build": "npm run build -w web-react",
		"build:svelte": "npm run build -w web-svelte",
		"build:frontends": "npm run build --workspaces --if-present",
		"build:react:docs": "npm run build -w web-react -- --base=./",
		"build:svelte:docs": "npm run build -w web-svelte -- --base=./",
		"build:frontends:docs": "npm run build:react:docs && npm run build:svelte:docs",
		"preview": "npm run preview -w web-react",
		"preview:svelte": "npm run preview -w web-svelte",
		"check": "npm run check -w web-react",
		"check:svelte": "npm run check -w web-svelte",
		"docs:prepare": "npm run build:frontends:docs && node scripts/prepare-docs.mjs",
		"docs:dev": "npm run docs:prepare && hugo server --source docs",
		"docs:build": "npm run docs:prepare && hugo --source docs --destination ../dist-docs --minify",
		"i18n:prune": "python scripts/prune-unused-translations.py",
		"i18n:prune:dry": "python scripts/prune-unused-translations.py --dry-run",
		"i18n:sync": "node scripts/csv-to-locales.mjs",
		"fixtures:tag-showcase:check": "python scripts/sync-tag-showcase-fixture.py --check",
		"fixtures:tag-showcase:sync": "python scripts/sync-tag-showcase-fixture.py",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"tauri": "tauri",
		"tauri:dev": "tauri dev --config src-tauri/tauri.react.conf.json",
		"tauri:dev:svelte": "tauri dev --config src-tauri/tauri.svelte.conf.json",
		"tauri:build": "tauri build --config src-tauri/tauri.react.conf.json",
		"tauri:build:svelte": "tauri build --config src-tauri/tauri.svelte.conf.json"
	},
	"optionalDependencies": {
		"@rolldown/binding-darwin-arm64": "1.2.12",
		"@rolldown/binding-darwin-x64": "1.2.12",
		"@rolldown/binding-linux-x64-gnu": "1.2.12",
		"@rolldown/binding-win32-x64-msvc": "1.2.12",
		"@tailwindcss/oxide-darwin-arm64": "4.3.3",
		"@tailwindcss/oxide-darwin-x64": "4.3.3",
		"@tailwindcss/oxide-linux-x64-gnu": "4.3.3",
		"@tailwindcss/oxide-win32-x64-msvc": "4.3.3",
		"@tauri-apps/cli-darwin-arm64": "2.12.1",
		"@tauri-apps/cli-darwin-x64": "2.12.1",
		"@tauri-apps/cli-linux-x64-gnu": "^2.12.1",
		"@tauri-apps/cli-win32-x64-msvc": "2.12.1",
		"lightningcss-darwin-arm64": "1.33.0",
		"lightningcss-darwin-x64": "1.33.0",
		"lightningcss-win32-x64-msvc": "1.33.0"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^9.39.5",
		"@tauri-apps/cli": "^2.12.1",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^16.5.0",
		"prettier": "^3.9.9",
		"prettier-plugin-tailwindcss": "^0.7.4",
		"typescript-eslint": "^8.71.1"
	}
}
